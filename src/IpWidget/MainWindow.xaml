<Window x:Class="IpWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IP Widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A0FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,1,14,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Card"
            CornerRadius="10"
            Background="#B0141414"
            BorderBrush="#30FFFFFF"
            BorderThickness="1"
            Padding="14,10,16,12"
            MinWidth="250">
        <StackPanel>
            <TextBlock x:Name="HostText" Foreground="White" FontSize="20" FontWeight="SemiBold" Text="HOSTNAME"/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="IP"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Value}" x:Name="IpText" FontSize="15" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="MAC"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" x:Name="MacText" FontFamily="Consolas"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="Type"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" x:Name="TypeText"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="Speed"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" x:Name="SpeedText"/>
            </Grid>
            <TextBlock x:Name="AdapterText" Margin="0,6,0,0" FontSize="11" Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="320" HorizontalAlignment="Left"/>
            <TextBlock x:Name="HintText" Margin="0,4,0,0" FontSize="11" Foreground="#FF7FC4FF" Visibility="Collapsed"
                       Text="Drag to move · right-click for options"/>
        </StackPanel>
    </Border>
</Window>
