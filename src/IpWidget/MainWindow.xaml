<Window x:Class="IpWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IP Widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- The hostname, then one row per adapter (built in code, columns line up):
         HOSTNAME
         [wifi]  192.168.1.20   AA-BB-CC-DD-EE-FF   1.2 Gbps
         [port]  192.168.1.21   11-22-33-44-55-66   1 Gbps -->
    <Border x:Name="Card"
            CornerRadius="12"
            Background="#A6141414"
            BorderBrush="#14FFFFFF"
            BorderThickness="1"
            Padding="14,8,14,9"
            >
        <!-- Two nested shadows (text-only mode) build a darker halo than one shadow can. -->
        <Decorator x:Name="Halo">
        <StackPanel x:Name="Body">
            <TextBlock x:Name="HostText"
                       Foreground="White" FontSize="17" FontWeight="SemiBold" Text="HOSTNAME"/>
            <Grid x:Name="Rows"/>
        </StackPanel>
        </Decorator>
    </Border>
</Window>
