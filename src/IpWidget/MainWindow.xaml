<Window x:Class="IpWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IP Widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Two compact rows:
         HOSTNAME                 WLAN · 1.2 Gbps
         192.168.1.20          AA-BB-CC-DD-EE-FF -->
    <Border x:Name="Card"
            CornerRadius="12"
            Background="#A6141414"
            BorderBrush="#14FFFFFF"
            BorderThickness="1"
            Padding="14,8,14,9"
            MinWidth="240">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="HostText" Grid.Row="0" Grid.Column="0"
                       Foreground="White" FontSize="17" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,18,0" Text="HOSTNAME"/>
            <TextBlock x:Name="LinkText" Grid.Row="0" Grid.Column="1"
                       Foreground="#B3FFFFFF" FontSize="12"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>

            <TextBlock x:Name="IpText" Grid.Row="1" Grid.Column="0"
                       Foreground="White" FontSize="14"
                       VerticalAlignment="Center" Margin="0,1,18,0"/>
            <TextBlock x:Name="MacText" Grid.Row="1" Grid.Column="1"
                       Foreground="#B3FFFFFF" FontSize="12" FontFamily="Consolas"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,1,0,0"/>
        </Grid>
    </Border>
</Window>
